# Use un valor alfanumérico distinto en cada instalación.
POSTGRES_PASSWORD=

# En producción, apunta los dos nombres al servidor.
WEB_HOST=
API_HOST=

# true carga equipos ficticios una vez por base de datos.
DEMO_DATA=false

# Solo para el modo local.
LOCAL_WEB_PORT=4173
LOCAL_API_PORT=4180
# Opcional. Usa minacontrol-local o minacontrol-local-<sufijo alfanumérico>.
LOCAL_PROJECT_NAME=minacontrol-local
